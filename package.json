{
  "name": "opencode-ds4-speed-meter",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package",
    "vllm",
    "telemetry"
  ],
  "exports": {
    "./core": {
      "import": "./ds4-speed-meter-core.mjs"
    },
    "./pi": {
      "import": "./pi.ts"
    },
    "./server": {
      "import": "./server.ts",
      "config": {
        "providerID": "ds4",
        "timeoutMs": 2000
      }
    },
    "./tui": {
      "import": "./tui.tsx",
      "config": {
        "providerID": "ds4",
        "label": "DS4",
        "statsPaths": [
          "stats",
          "../metrics"
        ],
        "intervalMs": 2000,
        "requestTimeoutMs": 1500,
        "windowMs": 6000
      }
    }
  },
  "pi": {
    "extensions": [
      "./pi.ts"
    ]
  },
  "engines": {
    "opencode": ">=1.18.15",
    "pi": ">=0.83.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "@opencode-ai/plugin": ">=1.18.15",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:hermes": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm test && npm run test:hermes && node --check ds4-speed-meter-core.mjs && node --check pi-beast-telemetry.mjs && node --check hermes/widget-core.mjs && node --check hermes/beast-meter.mjs"
  }
}
